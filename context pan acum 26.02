GDScript
extends Node

var current_turn: int = 1
var player_resources: int = 0

func start_player_turn(owned_territories: int):
	# FORMULA: 1 + jumătate din teritorii
	var income = 1 + floori(owned_territories / 2.0)
	player_resources = income
	print("Tura ", current_turn, ": Ai primit ", income, " resurse.")

func end_turn():
	current_turn += 1
Apasă Ctrl+S pentru a salva.

