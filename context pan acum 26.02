Iată primul script concret (Territory.gd), scris exact pe baza regulilor tale. Acesta se atașează pe obiectul care reprezintă un teritoriu (un Area2D).

Script 1: Territory.gd
(Gestionează unitățile, limita de 30 și culoarea)

GDScript
class_name Territory
extends Area2D

# --- SEMNALE ---
signal territory_selected(territory_ref)

# --- CONFIGURAȚIE ---
const MAX_UNITS: int = 30
const MIN_GARRISON: int = 1

# --- VARIABILE DE STARE ---
@export var territory_id: int = 0
@export var neighbors: Array[Territory] = [] # Se leagă manual în editor sau prin cod

# Proprietarul curent (0 = Player, 1 = AI, -1 = Neutru/Void)
var owner_id: int = -1 

# Numărul de unități (Setter pentru a actualiza automat textul/grafica)
var units: int = 1:
	set(value):
		# Aici aplicăm regula: Niciodată sub 1, niciodată peste 30
		units = clampi(value, MIN_GARRISON, MAX_UNITS)
		_update_visuals()

# Referințe la nodurile vizuale (trebuie să ai un Label și un Polygon2D ca copii)
@onready var label_units: Label = $LabelUnits
@onready var poly_shape: Polygon2D = $Polygon2D

func _ready():
	# Inițializare vizuală
	_update_visuals()
	
	# Conectare input (click pe teritoriu)
	input_event.connect(_on_input_event)

# --- LOGICA DE JOC ---

# Funcție pentru a adăuga unități (Recrutare sau Mutare)
# Returnează câte unități NU au putut fi adăugate (excesul)
func add_units(amount: int) -> int:
	var space_left = MAX_UNITS - units
	
	if space_left <= 0:
		return amount # Teritoriul e plin, returnăm tot
		
	var to_add = mini(amount, space_left)
	units += to_add
	
	return amount - to_add # Returnăm restul (dacă au mai rămas unități de plasat)

# Funcție pentru a scoate unități (pentru Atac sau Mutare)
# Returnează true dacă operațiunea e validă
func remove_units(amount: int) -> bool:
	if units - amount < MIN_GARRISON:
		print("Eroare: Trebuie să rămână minim 1 unitate garnizoană!")
		return false
	
	units -= amount
	return true

# Funcție chemată când teritoriul este cucerit
func conquer(new_owner_id: int, incoming_units: int, new_color: Color):
	owner_id = new_owner_id
	poly_shape.color = new_color
	
	# Resetăm unitățile la cele care au invadat (respectând limita)
	# Aici vom aplica logica de 60% în GameManager, dar teritoriul primește doar rezultatul final
	units = incoming_units 
	print("Teritoriul ", territory_id, " cucerit de ", new_owner_id)

# --- VIZUAL & INPUT ---

func _update_visuals():
	if label_units:
		label_units.text = str(units)
	# Aici poți adăuga logică pentru a schimba saturația culorii pe măsură ce se umple (opțional)

func _on_input_event(_viewport, event, _shape_idx):
	if event is InputEventMouseButton and event.pressed and event.button_index == MOUSE_BUTTON_LEFT:
		emit_signal("territory_selected", self)
Ce face acest script conform regulilor tale:
clampi(value, MIN_GARRISON, MAX_UNITS): Asigură matematic că niciun bug nu poate face ca un teritoriu să aibă 0 sau 31 de unități.

add_units returnează restul: Dacă ai 4 unități de plasat și teritoriul are deja 28, va pune 2, va ajunge la 30 și îți va returna 2 înapoi (ca să le pui altundeva).

remove_units protejează garnizoana: Nu te lasă să muți tot.

